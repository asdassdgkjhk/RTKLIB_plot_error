{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) launch", // 配置名称，用于在调试配置列表中显示
            "type": "cppdbg", // 调试器类型，使用 C++ 调试器
            "request": "launch", // 请求类型，表示启动调试
            "program": "${workspaceFolder}/build/rnx2rtkp.exe", // 要调试的可执行文件路径
            "args": [ // 传递给程序的命令行参数
                "-k",
                "${workspaceFolder}/spp.conf",
                // 输入文件路径里要用两个反斜杠\\连接，并且要全部分开输入
                "${workspaceFolder}\\input_data\\WUHN00CHN_R_20231550000_01D_30S_MO.rnx",
                "${workspaceFolder}\\input_data\\BRDM00DLR_S_20231550000_01D_MN.rnx", // 广播星历
                // "${workspaceFolder}\\input_data\\WUM0MGXFIN_20231550000_01D_05M_ORB.SP3", // 精密星历
                // "${workspaceFolder}\\input_data\\WUM0MGXFIN_20231550000_01D_30S_CLK.CLK", // 钟差校正文件
                "-o",
                "${workspaceFolder}/spp.txt",
            ],
            "stopAtEntry": false, // 是否在程序入口处停止
            "cwd": "${workspaceFolder}", // 设置工作目录为工作区根目录
            "environment": [], // 环境变量配置
            "externalConsole": true, // 是否使用外部控制台
            "MIMode": "gdb", // 调试器模式，使用 GDB
            "miDebuggerPath": "D:/tool/mingw_w64/mingw64/mingw64/bin/gdb.exe", // GDB 调试器路径
            "setupCommands": [ // 调试器初始化命令
                {
                    "text": "-enable-pretty-printing", // 启用 GDB 的格式化输出
                    "ignoreFailures": true // 忽略命令失败
                }
            ],
            "preLaunchTask": "C/C++: gcc.exe build active file" // 预启动task任务，编译程序
        }
    ]
}