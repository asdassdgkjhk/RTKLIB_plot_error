    "configurations": [
        {
            "name": "(gdb) launch", // 配置名称，用于在调试配置列表中显示
            "type": "cppdbg", // 调试器类型，使用 C++ 调试器
            "request": "launch", // 请求类型，表示启动调试
            "program": "${workspaceFolder}/build/rnx2rtkp.exe", // 要调试的可执行文件路径
            "args": [ // 传递给程序的命令行参数
                "-k",
                // "${workspaceFolder}/spp.conf",
                // "${workspaceFolder}/single.conf",
                "${workspaceFolder}/ppp.conf",
                // "${workspaceFolder}/rtk.conf",
                // 输入文件路径里要用两个反斜杠\\连接，并且要全部分开输入
                // "${workspaceFolder}\\input_data\\WUHN00CHN_R_20233300000_01D_30S_MO.rnx", // 2023年330天的观测文件 SPP
                "${workspaceFolder}\\input_data\\HKWS00HKG_R_20233300000_01D_30S_MO.rnx",
                "${workspaceFolder}\\input_data\\BRDM00DLR_S_20233300000_01D_MN.rnx", // 广播星历
                "${workspaceFolder}\\input_data\\WUM0MGXFIN_20233300000_01D_05M_ORB.SP3", // 精密星历SP3文件
                "${workspaceFolder}\\input_data\\WUM0MGXFIN_20233300000_01D_30S_CLK.CLK", // 精密时钟CLK文件
