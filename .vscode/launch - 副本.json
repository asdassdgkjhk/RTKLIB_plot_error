                // "${workspaceFolder}\\input_data\\graphgnsslib_data\\COM3_190428_124409.obs", // rtk移动站观测文件 COM3
                // "${workspaceFolder}\\input_data\\HKSL00HKG_R_20211370000_01D_30S_MO.rnx", // rtk基站观测文件 medium
                // "${workspaceFolder}\\input_data\\graphgnsslib_data\\hksc1180.19o", // rtk基站观测文件 COM3
                // "${workspaceFolder}\\input_data\\BRDM00DLR_S_20211370000_01D_MN.rnx", // 广播星历 medium
                // "${workspaceFolder}\\input_data\\graphgnsslib_data\\BRDC00IGS_R_20191180000_01D_MN.rnx", // 广播星历 COM3
                // spp/ppp
                // "-ts",
                // "2023/11/26",
                // "11:00:00",
                // "-te",
                // "2023/11/26",
                // "12:00:00",
                // rtk medium
                // "-ts",
                // "2021/05/17",
                // "02:34:13",
                // "-te",
                // "2021/05/17",
                // "02:46:00",
                // rtk COM3
                // "-ts",
                // "2019/04/28",
                // "12:44:33",
                // "-te",
                // "2019/04/28",
                // "13:13:54",
                "-x", // trace文件输出等级
                "3",
                "-o",
                // "${workspaceFolder}/spp.txt"
                "${workspaceFolder}/ppp.txt"
                // "${workspaceFolder}/rtk.txt"
            ],
            "stopAtEntry": false, // 是否在程序入口处停止
            "cwd": "${workspaceFolder}", // 设置工作目录为工作区根目录
            "environment": [], // 环境变量配置
            "externalConsole": true, // 是否使用外部控制台
            "MIMode": "gdb", // 调试器模式，使用 GDB
            "miDebuggerPath": "D:/tool/mingw_w64/mingw64/mingw64/bin/gdb.exe", // GDB 调试器路径
            "setupCommands": [ // 调试器初始化命令
                {
                    "text": "-enable-pretty-printing", // 启用 GDB 的格式化输出
                    "ignoreFailures": true // 忽略命令失败
                }
            ],
            "preLaunchTask": "C/C++: gcc.exe build active file" // 预启动task任务，编译程序
        }
    ]
}